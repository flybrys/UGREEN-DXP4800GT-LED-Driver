#!/bin/bash
set -Eeuo pipefail

# UGREEN DXP4800 GT front-panel LEDs for Unraid.
# The kernel modules are distributed separately for each exact Unraid kernel.

plugin_dir=/boot/config/plugins/UGREEN-DXP4800GT-LED-Driver
config_file=${UGREEN_GT_CONFIG:-$plugin_dir/settings.cfg}
pid_file=${UGREEN_GT_PID_FILE:-/run/ugreen-gt-leds.pid}
lock_file=${UGREEN_GT_LOCK_FILE:-/run/ugreen-gt-leds.lock}
log_file=${UGREEN_GT_LOG_FILE:-/var/log/ugreen-gt-leds.log}

POWER_COLOR='255 255 255'
POWER_BRIGHTNESS=180
NETWORK_INTERFACE=auto
NETWORK_BRIGHTNESS=180
NETWORK_COLOR_ONLINE='255 255 255'
NETWORK_COLOR_OFFLINE='255 165 0'
CONNECTIVITY_METHOD=https
CONNECTIVITY_URL='https://unraid.net/'
CONNECTIVITY_FALLBACK_URL='https://ai.ugreen.com/'
CONNECTIVITY_INTERVAL=60
NETWORK_ACTIVITY_BYTES=65536
DISK_COLOR='255 255 255'
DISK_COLOR_FAILED='255 165 0'
DISK_BRIGHTNESS=180
DISK_ACTIVITY_STYLE=solid
DISK_PULSE_MS=80
DISK_ATA_PORTS=(1 2 3 4)
POLL_INTERVAL=0.5
REFRESH_INTERVAL=15
DISK_STATUS_INTERVAL=30

if [[ -f $config_file ]]; then
  # This is an administrator-owned shell configuration file on the boot device.
  source "$config_file"
fi

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }
led_path() { printf '/sys/class/leds/%s' "$1"; }

model_check() {
  [[ $(cat /sys/class/dmi/id/product_name) == 'DXP4800 GT' ]] ||
    fail 'This plugin supports only DXP4800 GT.'
}

module_loaded() { grep -q "^${1}[[:space:]]" /proc/modules; }

load_module() {
  local name=$1 file=$2
  shift 2
  if module_loaded "${name//-/_}"; then return 0; fi
  case $name in
    i2c-designware-core|i2c-designware-platform|led-ugreen)
      if [[ -n ${UGREEN_GT_MODULE_DIR:-} ]]; then
        insmod "$UGREEN_GT_MODULE_DIR/$file" "$@"
      else
        modprobe "$name" "$@"
      fi ;;
    *) modprobe "$name" "$@" ;;
  esac
}

find_mcu_bus() {
  local path name bus chip client
  for path in /sys/class/i2c-dev/i2c-*; do
    [[ -r $path/name ]] || continue
    [[ $(cat "$path/name") == 'Synopsys DesignWare I2C adapter' ]] || continue
    name=${path##*/}
    bus=${name#i2c-}
    client=/sys/bus/i2c/devices/${bus}-003a
    if [[ -e $client ]]; then
      [[ $(cat "$client/name") == 'led-ugreen' ]] ||
        fail "I2C address 0x3a on $name is in use by another driver."
      printf '%s\n' "$name"
      return 0
    fi
    chip=$(i2cget -y "$bus" 0x3a 0x5a w 2>/dev/null || true)
    if [[ $chip == 0xc5b2 ]]; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  return 1
}

setup_hardware() {
  model_check
  command -v i2cget >/dev/null || fail 'i2cget is required to locate the LED MCU.'
  load_module i2c-dev i2c-dev.ko
  load_module i2c-designware-core i2c-designware-core.ko
  load_module i2c-designware-platform i2c-designware-platform.ko
  load_module ledtrig-oneshot ledtrig-oneshot.ko
  if module_loaded led_ugreen; then
    [[ -r /sys/module/led_ugreen/parameters/write_protocol ]] ||
      fail 'An older led-ugreen module is loaded. Remove the other UGREEN LED plugin.'
    [[ $(cat /sys/module/led_ugreen/parameters/write_protocol) == smbus-block ]] ||
      fail 'led-ugreen is loaded with the wrong protocol.'
  else
    load_module led-ugreen led-ugreen.ko write_protocol=smbus-block num_disk_leds=4
  fi
  local bus
  bus=$(find_mcu_bus) || fail 'UGREEN LED MCU was not found on a DesignWare bus.'
  if [[ ! -e /sys/bus/i2c/devices/${bus#i2c-}-003a ]]; then
    printf 'led-ugreen 0x3a\n' > "/sys/bus/i2c/devices/$bus/new_device"
  fi
  [[ -d $(led_path power) && -d $(led_path netdev) && -d $(led_path disk1) ]] ||
    fail 'LED module did not create the expected sysfs entries.'
  log "LED MCU bound on $bus."
}

pick_network_interface() {
  if [[ $NETWORK_INTERFACE != auto ]]; then
    printf '%s\n' "$NETWORK_INTERFACE"
  else
    ip -o route show default | awk 'NR == 1 { print $5 }'
  fi
}

https_reachable() {
  local iface=$1 url=$2
  [[ -n $url ]] || return 1
  curl --silent --fail --head --location --output /dev/null --connect-timeout 2 \
    --max-time 5 --interface "$iface" "$url"
}

internet_reachable() {
  local iface=$1 gateway
  case $CONNECTIVITY_METHOD in
    https)
      https_reachable "$iface" "$CONNECTIVITY_URL" ||
        https_reachable "$iface" "$CONNECTIVITY_FALLBACK_URL" ;;
    gateway)
      gateway=$(ip -4 route show default dev "$iface" | awk 'NR == 1 { print $3 }')
      [[ -n $gateway ]] && ping -n -c 1 -W 2 -I "$iface" "$gateway" >/dev/null 2>&1 ;;
    none) return 0 ;;
    *) fail "Unknown CONNECTIVITY_METHOD: $CONNECTIVITY_METHOD" ;;
  esac
}

configure_network() {
  local iface carrier mode color
  iface=$(pick_network_interface)
  if [[ -n $iface && -d /sys/class/net/$iface ]]; then
    carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || true)
  else
    carrier=0
  fi
  if [[ $carrier != 1 ]]; then
    mode=down
  else
    if [[ ${current_network_interface:-} != "$iface" ]] ||
       (( SECONDS >= ${next_connectivity_check:-0} )); then
      if internet_reachable "$iface"; then
        network_online=1
      else
        network_online=0
      fi
      next_connectivity_check=$((SECONDS + CONNECTIVITY_INTERVAL))
    fi
    if [[ ${network_online:-0} == 1 ]]; then mode=online; else mode=offline; fi
  fi
  if [[ $mode == online ]]; then color=$NETWORK_COLOR_ONLINE; else color=$NETWORK_COLOR_OFFLINE; fi
  if [[ ${current_network_interface:-} != "$iface" || ${current_network_mode:-} != "$mode" ]]; then
    printf 'none\n' > /sys/class/leds/netdev/trigger
    printf 'none\n' > /sys/class/leds/netdev/blink_type
    printf '%s\n' "$color" > /sys/class/leds/netdev/color
    printf '%s\n' "$NETWORK_BRIGHTNESS" > /sys/class/leds/netdev/brightness
    if [[ $mode != down ]]; then
      printf 'oneshot\n' > /sys/class/leds/netdev/trigger
      printf '1\n' > /sys/class/leds/netdev/invert
      printf '100\n' > /sys/class/leds/netdev/delay_on
      printf '100\n' > /sys/class/leds/netdev/delay_off
    fi
    current_network_interface=$iface
    current_network_mode=$mode
    network_rx_bytes=''
    network_tx_bytes=''
    log "Network LED: $mode on $iface."
  fi
}

poll_network_activity() {
  local iface=${current_network_interface:-} rx tx delta
  [[ ${current_network_mode:-down} != down && -n $iface ]] || return 0
  [[ -r /sys/class/net/$iface/statistics/rx_bytes &&
     -r /sys/class/net/$iface/statistics/tx_bytes ]] || return 0
  read -r rx < "/sys/class/net/$iface/statistics/rx_bytes" || return 0
  read -r tx < "/sys/class/net/$iface/statistics/tx_bytes" || return 0
  if [[ -n ${network_rx_bytes:-} && -n ${network_tx_bytes:-} ]]; then
    delta=$((rx - network_rx_bytes + tx - network_tx_bytes))
    if (( delta >= NETWORK_ACTIVITY_BYTES )); then
      printf '1\n' > /sys/class/leds/netdev/shot
      [[ ${UGREEN_GT_DEBUG:-0} == 1 ]] && log "Network activity: $delta bytes on $iface."
    fi
  fi
  network_rx_bytes=$rx
  network_tx_bytes=$tx
}

device_on_ata_port() {
  local port=$1 block path
  for block in /sys/class/block/sd*; do
    [[ -e $block/device ]] || continue
    path=$(readlink -f "$block/device")
    if [[ $path == *"/ata${port}/"* ]]; then
      printf '%s\n' "${block##*/}"
      return 0
    fi
  done
  return 1
}

declare -A bay_device bay_signature bay_mode

set_bay_mode() {
  local bay=$1 mode=$2 path
  [[ ${bay_mode[$bay]:-} == "$mode" ]] && return 0
  path=$(led_path "disk$bay")
  printf 'none\n' > "$path/trigger"
  case $mode in
    active)
      printf 'none\n' > "$path/blink_type"
      case $DISK_ACTIVITY_STYLE in
        solid)
          printf '0\n' > "$path/brightness"
          printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '1\n' > "$path/invert"
          printf '1\n' > "$path/delay_on"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_off"
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
          printf 'none\n' > "$path/blink_type" ;;
        dark)
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '0\n' > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '0\n' > "$path/invert"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_on"
          printf '100\n' > "$path/delay_off" ;;
        *) fail "Unknown DISK_ACTIVITY_STYLE: $DISK_ACTIVITY_STYLE" ;;
      esac ;;
    standby)
      printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR" > "$path/color"
      printf 'breath 1000 1000\n' > "$path/blink_type" ;;
    failed)
      printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR_FAILED" > "$path/color"
      printf 'blink 500 500\n' > "$path/blink_type" ;;
    *) fail "Unknown disk LED mode: $mode" ;;
  esac
  bay_mode[$bay]=$mode
  log "disk$bay: $mode."
}

disk_health_mode() {
  local device=$1 status
  status=$(smartctl -n standby -H -j "/dev/$device" 2>/dev/null || true)
  [[ -n $status ]] || { printf 'active\n'; return; }
  jq -r 'if .power_mode.name == "STANDBY" then "standby"
         elif .smart_status.passed == false then "failed"
         else "active" end' <<< "$status" 2>/dev/null || printf 'active\n'
}

refresh_bay_health() {
  local bay device mode
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device ]] || continue
    mode=$(disk_health_mode "$device")
    set_bay_mode "$bay" "$mode"
  done
}

configure_bay() {
  local bay=$1 port=$2 led="disk$1" device path
  path=$(led_path "$led")
  [[ -d $path ]] || return 0
  device=$(device_on_ata_port "$port" || true)
  if [[ ${bay_device[$bay]-unset} == "$device" ]]; then return 0; fi
  if [[ -n $device ]]; then
    bay_device[$bay]=$device
    bay_mode[$bay]=''
    bay_signature[$bay]=''
    log "$led monitors ATA port $port ($device)."
  else
    printf 'none\n' > "$path/trigger"
    printf 'none\n' > "$path/blink_type"
    printf '0\n' > "$path/brightness"
    bay_device[$bay]=''
    bay_mode[$bay]=''
    bay_signature[$bay]=''
    log "$led: ATA port $port is empty."
  fi
}

poll_disk_activity() {
  local bay device path signature
  local -a counters
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device && -r /sys/class/block/$device/stat ]] || continue
    read -r -a counters < "/sys/class/block/$device/stat" || continue
    (( ${#counters[@]} >= 7 )) || continue
    signature="${counters[2]}:${counters[6]}"
    path=$(led_path "disk$bay")
    if [[ -n ${bay_signature[$bay]:-} && ${bay_signature[$bay]} != "$signature" ]]; then
      if [[ ${bay_mode[$bay]:-} == standby ]]; then set_bay_mode "$bay" active; fi
      if [[ ${bay_mode[$bay]:-} == active ]] && ! activity_helper_running; then
        printf '1\n' > "$path/shot"
      fi
      [[ ${UGREEN_GT_DEBUG:-0} == 1 ]] && log "Activity on disk$bay ($device)."
    fi
    bay_signature[$bay]=$signature
  done
}

activity_helper_running() {
  [[ -n ${activity_pid:-} ]] && kill -0 "$activity_pid" 2>/dev/null
}

start_activity_helper() {
  local helper=${UGREEN_GT_ACTIVITY_HELPER:-/usr/local/sbin/ugreen-gt-disk-activity}
  [[ -x $helper ]] || { log 'Event-driven disk activity helper is unavailable; using polling.'; return 0; }
  "$helper" "${DISK_ATA_PORTS[@]}" >> "$log_file" 2>&1 &
  activity_pid=$!
  sleep 0.2
  if activity_helper_running; then
    log "Event-driven disk activity helper started as PID $activity_pid."
  else
    wait "$activity_pid" || true
    activity_pid=''
    log 'Event-driven disk activity helper could not start; using polling.'
  fi
}

cleanup() {
  if activity_helper_running; then
    kill "$activity_pid" 2>/dev/null || true
    wait "$activity_pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

run() {
  exec 9> "$lock_file"
  flock -n 9 || fail 'LED monitor is already running.'
  printf '%s\n' "$$" > "$pid_file"
  trap cleanup EXIT
  setup_hardware
  printf 'none\n' > /sys/class/leds/power/trigger
  printf 'none\n' > /sys/class/leds/power/blink_type
  printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
  printf '%s\n' "$POWER_BRIGHTNESS" > /sys/class/leds/power/brightness
  configure_network
  local bay next_refresh=0 next_disk_status=0
  start_activity_helper
  while :; do
    if (( SECONDS >= next_refresh )); then
      for bay in 1 2 3 4; do
        configure_bay "$bay" "${DISK_ATA_PORTS[bay-1]}"
      done
      configure_network
      next_refresh=$((SECONDS + REFRESH_INTERVAL))
    fi
    if (( SECONDS >= next_disk_status )); then
      refresh_bay_health
      next_disk_status=$((SECONDS + DISK_STATUS_INTERVAL))
    fi
    poll_disk_activity
    poll_network_activity
    sleep "$POLL_INTERVAL"
  done
}

running_pid() {
  local pid
  local -a argv=()
  [[ -r $pid_file ]] || return 1
  read -r pid < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv < "/proc/$pid/cmdline" || return 1
  [[ ${argv[1]:-} == "$0" && ${argv[2]:-} == run ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

case ${1:-} in
  run) run ;;
  start)
    if running_pid >/dev/null; then
      echo 'UGREEN GT LED monitor is already running.'
      exit 0
    fi
    nohup "$0" run >> "$log_file" 2>&1 < /dev/null &
    echo "UGREEN GT LED monitor started as PID $!."
    ;;
  stop)
    pid=$(running_pid) && kill "$pid" 2>/dev/null || true
    ;;
  shutdown)
    "$0" stop
    flock -w 10 "$lock_file" true || true
    if [[ -w /sys/class/leds/power/blink_type ]]; then
      printf 'none\n' > /sys/class/leds/power/trigger
      printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
      printf '%s\n' "$POWER_BRIGHTNESS" > /sys/class/leds/power/brightness
      printf 'blink 500 500\n' > /sys/class/leds/power/blink_type
    fi
    ;;
  status)
    if running_pid >/dev/null; then
      echo 'UGREEN GT LED monitor is running.'
    else
      echo 'UGREEN GT LED monitor is stopped.'
      exit 1
    fi
    ;;
  *) echo "Usage: $0 {start|stop|shutdown|status|run}" >&2; exit 2 ;;
esac
