<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
  <!ENTITY name "UGREEN-DXP4800GT-LED-Driver">
  <!ENTITY package "ugreen-dxp4800gt-leds">
  <!ENTITY version "2026.09.25.4dev2">
  <!ENTITY plugin "/boot/config/plugins/&name;">
  <!ENTITY release "https://github.com/flybrys/UGREEN-DXP4800GT-LED-Driver/releases/download/v&version;">
]>
<PLUGIN name="&name;" author="flybrys" version="&version;" icon="lightbulb-o"
        pluginURL="https://raw.githubusercontent.com/flybrys/UGREEN-DXP4800GT-LED-Driver/dev/UGREEN-DXP4800GT-LED-Driver.plg"
        min="7.3.2" support="https://github.com/flybrys/UGREEN-DXP4800GT-LED-Driver/issues">
<CHANGES>
###2026.09.25.4dev2
- Render the settings form directly as HTML in Unraid's page layout.

###2026.09.25.4dev1
- Keep active drive LEDs solid between per-drive I/O events, with brief off pulses.
- Add a native Unraid settings page with colour pickers and validated controls.

###2026.09.25.3
- Drive LEDs respond to individual read and write requests and stay dark while idle.
- Show a light icon and readable description on Unraid's Plugins page.

###2026.09.25.2
- Keep the LAN LED steady during background traffic; flash for larger transfers.
- Check UGREEN's site if unraid.net is unavailable.
- Keep monitoring disks and power when the default network route disappears.
- Harden process control and LED driver error handling.

###2026.09.25.1
- Use UGREEN's white/orange LAN meanings instead of link-speed colors.
- Breathe white for standby drives and blink orange for explicit SMART failure.
- Blink the white power LED during orderly Unraid shutdown.

###2026.09.25
- Initial support for DXP4800 GT on Unraid 7.3.2 (kernel 6.18.38-Unraid).
</CHANGES>

<FILE Run="/bin/bash">
<INLINE>
set -e
[[ $(uname -r) == 6.18.38-Unraid ]] || { echo 'Unsupported kernel; exact matching modules are required.' &gt;&amp;2; exit 1; }
[[ $(cat /sys/class/dmi/id/product_name) == 'DXP4800 GT' ]] || { echo 'DXP4800 GT required.' &gt;&amp;2; exit 1; }
[[ ! -f /boot/config/plugins/ugreen-dxp4800gt-leds.plg ]] || { echo 'Remove the earlier plugin release before installing this renamed plugin.' &gt;&amp;2; exit 1; }
[[ ! -f /boot/config/plugins/ugreenleds-driver.plg ]] || { echo 'Remove the old ugreenleds-driver plugin first.' &gt;&amp;2; exit 1; }
</INLINE>
</FILE>

<FILE Name="&plugin;/i2c-tools-4.3-x86_64-1.txz" Run="upgradepkg --install-new">
<URL>&release;/i2c-tools-4.3-x86_64-1.txz</URL>
<SHA256>9730e890d81743f4827715ae38019715fe8252c9bc6d95af4b5f64339238106c</SHA256>
</FILE>

<FILE Name="&plugin;/&package;-&version;-x86_64-1.txz" Run="upgradepkg --install-new">
<URL>&release;/&package;-&version;-x86_64-1.txz</URL>
<SHA256>24937cbdade48309afabf50dd3088dc74b8c31b22ea73dc23691225475639230</SHA256>
</FILE>

<FILE Name="&plugin;/settings.example.cfg">
<INLINE>
# Copy to settings.cfg to customize. Defaults are suitable for DXP4800 GT.
POWER_COLOR='255 255 255'
POWER_BRIGHTNESS=180
NETWORK_INTERFACE=auto
NETWORK_BRIGHTNESS=180
NETWORK_COLOR_ONLINE='255 255 255'
NETWORK_COLOR_OFFLINE='255 165 0'
CONNECTIVITY_METHOD=https
CONNECTIVITY_URL='https://unraid.net/'
CONNECTIVITY_FALLBACK_URL='https://ai.ugreen.com/'
CONNECTIVITY_INTERVAL=60
NETWORK_ACTIVITY_BYTES=65536
DISK_COLOR='255 255 255'
DISK_COLOR_FAILED='255 165 0'
DISK_BRIGHTNESS=180
DISK_ACTIVITY_STYLE=solid
DISK_PULSE_MS=80
DISK_ATA_PORTS=(1 2 3 4)
POLL_INTERVAL=0.5
REFRESH_INTERVAL=15
DISK_STATUS_INTERVAL=30
</INLINE>
<SHA256>5df57e7f5840ce2408e44b196f70aca6745045391675400dbcce81cf03ba3105</SHA256>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
set -e
/usr/local/sbin/ugreen-gt-leds stop 2&gt;/dev/null || true
flock -w 10 /run/ugreen-gt-leds.lock true
depmod -a
if [[ ! -f /boot/config/stop ]]; then
  printf '#!/bin/bash\n' &gt; /boot/config/stop
  chmod 755 /boot/config/stop
  touch &plugin;/stop-created
fi
if ! grep -Fq '# UGREEN-DXP4800GT-LED-Driver' /boot/config/stop; then
  printf '\n%s\n' '/usr/local/sbin/ugreen-gt-leds shutdown # UGREEN-DXP4800GT-LED-Driver' &gt;&gt; /boot/config/stop
fi
/usr/local/sbin/ugreen-gt-leds start
sleep 2
/usr/local/sbin/ugreen-gt-leds status
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
/usr/local/sbin/ugreen-gt-leds stop 2&gt;/dev/null || true
sleep 1
if [[ -f /boot/config/stop ]]; then
  sed -i '\@/usr/local/sbin/ugreen-gt-leds shutdown # UGREEN-DXP4800GT-LED-Driver@d' /boot/config/stop
  if [[ -f &plugin;/stop-created ]]; then
    if [[ $(grep -v '^[[:space:]]*$' /boot/config/stop) == '#!/bin/bash' ]]; then
      rm -f /boot/config/stop
    fi
  fi
fi
for dev in /sys/bus/i2c/devices/*-003a; do
  [[ -e $dev &amp;&amp; $(cat "$dev/name" 2&gt;/dev/null) == led-ugreen ]] || continue
  bus=${dev##*/}; bus=${bus%-003a}
  printf '0x3a\n' &gt; "/sys/bus/i2c/devices/i2c-$bus/delete_device"
done
modprobe -r led-ugreen i2c-designware-platform i2c-designware-core 2&gt;/dev/null || true
removepkg &package;-&version;-x86_64-1 2&gt;/dev/null || true
rm -rf &plugin;
</INLINE>
</FILE>
</PLUGIN>
